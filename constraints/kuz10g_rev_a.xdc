create_clock -name sys_clk_100m -period 10.000 [get_ports SYS_CLK_100M]
create_clock -name pcie_refclk -period 10.000 [get_ports MGTREFCLK0_115_P]
create_clock -name sfp_refclk_156m25 -period 6.400 [get_ports MGTREFCLK0_116_P]
set_false_path -from [get_ports {PCIE_PERST_N BTN_N PG_3V3 UART_RXD SFP*_TX_FAULT SFP*_MOD_ABS SFP*_LOS}]
set_false_path -to [get_ports {LED* UART_TXD SFP*_TX_DIS}]
